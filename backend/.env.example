# SpaceGuard Backend — copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin SDK JSON file (download from Firebase Console → Project Settings → Service Accounts)
# Place the file inside the backend/ directory.
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Current AI provider for text reasoning.
# Optional for now.
MISTRAL_API_KEY=your_ai_provider_key_here

# World Labs / World Models API — used for branch-based world generation.
# Required for the new satellite simulation visuals.
WORLDLABS_API_KEY=paste_worldlabs_api_key_here

# Gemini — optional prompt enhancer for cleaner world-generation prompts.
GEMINI_API_KEY=paste_gemini_api_key_here

# Weights & Biases — used for Weave tracing of orbital physics + agent decisions
# Create an account and API key from https://wandb.ai/site/
WANDB_API_KEY=your_wandb_api_key_here

# NASA APIs — used for Near Earth Objects (NeoWs) and Space Weather (DONKI)
# DEMO_KEY is used automatically if this is not set (rate-limited to ~30 req/hr).
# Get a free key at https://api.nasa.gov
NASA_API_KEY=your_nasa_api_key_here

# OpenWeatherMap — used to augment launch risk with pad weather data (optional)
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Space-Track.org — Authoritative TLEs and CDMs
# Get a free account at https://www.space-track.org
SPACETRACK_USER=your_spacetrack_email_here
SPACETRACK_PASSWORD=your_spacetrack_password_here

# NOAA SWPC — Space Weather Indices (No key required for many endpoints, but good to have docs)
# Documentation: https://www.swpc.noaa.gov/content/data-access

# N2YO — Localized satellite tracking (optional)
# Get a free key at https://www.n2yo.com/api/
N2YO_API_KEY=your_n2yo_api_key_here

# White Circle AI Safety — used to secure the Mistral financial agent
# Replace with your actual White Circle API key
WHITECIRCLE_API_KEY=your_whitecircle_api_key_here
